rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true if the authenticated user is an admin of the given business slug.
    // Uses a cross-document read — counted toward Firestore read quotas.
    function isAdminOfSlug(slug) {
      return request.auth != null
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.slugs.hasAny([slug]);
    }

    // Business config — public read, write via Admin SDK only (onboarding API route)
    match /businesses/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /admins/{uid} {
      // Only the user themselves can read their own admin record
      allow get: if request.auth != null && request.auth.uid == uid;
      // No client writes — admin records are managed out-of-band (Firebase Console / Cloud Functions)
      allow write: if false;
    }

    match /bookings/{bookingId} {

      // Single-document fetch: owner OR admin of that booking's business
      allow get: if request.auth != null
                 && (request.auth.uid == resource.data.userId
                     || isAdminOfSlug(resource.data.businessSlug));

      // Queries:
      //   - Authenticated users can query their own bookings (any status)
      //   - Admins can query all bookings for their business slug
      //   - Public availability reads go through GET /api/availability (Admin SDK, no PII exposed)
      allow list: if (request.auth != null && resource.data.userId == request.auth.uid)
                  || isAdminOfSlug(resource.data.businessSlug);

      // Create: authenticated, booking starts as confirmed (legacy/instant) or slot_held
      // (P2P payment flow — slots reserved pending receipt upload).
      // Admins may also create bookings on behalf of others (walk-ins) with userId != auth.uid.
      allow create: if request.auth != null
                    && request.resource.data.status in ["confirmed", "slot_held"]
                    && request.resource.data.totalPrice is number
                    && request.resource.data.totalPrice >= 0
                    && (request.resource.data.userId == request.auth.uid
                        || isAdminOfSlug(request.resource.data.businessSlug));

      // Update:
      //   - Owner can only flip status to "cancelled"; no other field changes
      //   - Admins can update any field on bookings for their business
      allow update: if request.auth != null
                    && (
                      (request.auth.uid == resource.data.userId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                        && request.resource.data.status == "cancelled")
                      || isAdminOfSlug(resource.data.businessSlug)
                    );

      // No deletes ever
      allow delete: if false;
    }

    match /credits/{creditId} {
      // Players read their own credits; admins read credits for their business
      allow get, list: if request.auth != null
                       && (resource.data.userId == request.auth.uid
                           || isAdminOfSlug(resource.data.businessSlug));
      // All writes go through Admin SDK (cancel and bookings API routes)
      allow write: if false;
    }

    match /businesses/{slug}/credit_ledger/{entryId} {
      // Only admins of this business can read ledger entries
      allow get, list: if isAdminOfSlug(slug);
      // All writes go through Admin SDK (payment confirmation routes)
      allow write: if false;
    }
  }
}
